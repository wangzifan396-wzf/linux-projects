# fail2ban jail.local 覆盖配置
# 部署位置: /etc/fail2ban/jail.local
# 不要改 jail.conf（升级会被覆盖），只在这里覆盖
# 部署后: sudo systemctl restart fail2ban

[DEFAULT]
backend = systemd             # Ubuntu 24.04 用 journald 后端（不是 file/auth.log）
bantime = 3600                 # 封禁 1 小时（-1 = 永久）
findtime = 600                 # 10 分钟窗口
maxretry = 5                   # 5 次失败触发
banaction = ufw                # 用 ufw 而不是 iptables 多协议封禁
ignoreip = 127.0.0.1/8 ::1 192.168.0.0/16 10.0.0.0/8   # 内网不封

[sshd]
enabled = true
port = 2222                    # ⚠️ 如果改了 sshd Port，这里必须同步
maxretry = 3                   # sshd 失败比其他敏感
bantime = 86400                # sshd 失败封 1 天
findtime = 600
